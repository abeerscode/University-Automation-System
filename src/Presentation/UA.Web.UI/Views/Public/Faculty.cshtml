@model IReadOnlyList<UA.Facade.DTO.Website.PublicFaculty>
@{ViewData["Title"]="Faculty directory";}
<h1>Faculty directory</h1><div class="public-grid">@foreach(var f in Model){<article class="public-card"><h2>@f.Name</h2><p>@f.Designation · @f.Department</p><p>@f.Qualifications</p></article>}</div>@if(Model.Count==0){<p>No active faculty records are available.</p>}
