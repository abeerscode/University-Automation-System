@model UA.Facade.DTO.Admission.AdmissionResultRow
@{ViewData["Title"]="Admission result";}
<h1>Admission result search</h1><p>Enter your applicant ID, intake year and date of birth. Only your published admission outcome is displayed.</p><form asp-action="Result" method="post" class="public-card" style="max-width:32rem"><label>Applicant ID</label><input name="applicantId" type="number" min="1" required class="form-control mb-2"/><label>Intake year</label><input name="year" type="number" min="2000" max="2100" required class="form-control mb-2"/><label>Date of birth</label><input name="birth" type="date" required class="form-control mb-3"/><button class="btn btn-primary">Search result</button></form>
@if(ViewBag.Searched==true){if(Model==null){<p class="mt-3">No matching published result found.</p>}else{<article class="public-card mt-3"><h2>@Model.Selection</h2><p>Applicant @Model.ApplicantId · @Model.Year · @Model.Department</p><p>Merit rank: @Model.Rank · Marks: @Model.Marks</p></article>}}
