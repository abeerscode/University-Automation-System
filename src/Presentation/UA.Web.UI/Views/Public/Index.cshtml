@model UA.Facade.DTO.Website.WebsiteHome
@{ViewData["Title"]="Home";}
<section class="public-hero"><p class="eyebrow">University information &amp; services</p><h1>Learn. Discover. Connect.</h1><p>Explore our academic departments, admission opportunities and university notices.</p><a class="btn btn-light" asp-action="Admission">Explore admission</a> <a class="btn btn-outline-light" asp-action="Result">Check admission result</a></section>
<section class="public-section"><h2>Academic departments</h2><div class="public-grid">@foreach(var d in Model.Departments){<article class="public-card"><span class="eyebrow">@d.Code</span><h3>@d.Name</h3><p>@(d.Program??"Program information will be published here.")</p><a asp-action="Department" asp-route-id="@d.Id">Department information</a></article>}</div></section>
<section class="public-section"><h2>Latest notices</h2>@if(Model.Notices.Count==0){<p>No public notices have been published.</p>}@foreach(var n in Model.Notices.Take(6)){<article class="notice"><small>@n.Published.ToString("dd MMM yyyy") · @n.Department</small><h3>@n.Title</h3><p style="white-space:pre-wrap">@n.Body</p></article>}<a asp-action="Notices">All notices</a></section>
<section class="public-section"><h2>University information</h2>@foreach(var p in Model.Pages.Where(x=>x.DepartmentId==null&&x.Slug!="site-profile")){<p><a asp-action="Page" asp-route-id="@p.Slug">@p.Title</a></p>}</section>
