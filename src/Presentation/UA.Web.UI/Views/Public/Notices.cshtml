@model IReadOnlyList<UA.Facade.DTO.Website.PublicNotice>
@{ViewData["Title"]="Notices";}
<h1>University notices</h1>@if(Model.Count==0){<p>No public notices have been published.</p>}@foreach(var n in Model){<article class="notice"><small>@n.Published.ToString("dd MMM yyyy") · @n.Department</small><h2>@n.Title</h2><p style="white-space:pre-wrap">@n.Body</p></article>}
