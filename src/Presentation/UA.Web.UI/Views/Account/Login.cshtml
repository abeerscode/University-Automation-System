@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<section class="auth-card"><h1>Sign in</h1><p>University Automation System</p>
<form asp-action="Login" method="post">
<input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div>
<label asp-for="Username"></label><input asp-for="Username" class="form-control" autocomplete="username" />
<label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="current-password" />
<button class="btn btn-primary mt-3" type="submit">Sign in</button>
</form><p class="mt-3"><a asp-action="ForgotPassword">Forgot password?</a></p></section>
