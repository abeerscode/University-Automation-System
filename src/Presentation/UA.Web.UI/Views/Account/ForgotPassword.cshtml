@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }
<h1>Reset password</h1><form method="post" asp-action="ForgotPassword"><div asp-validation-summary="All" class="text-danger"></div>
<label asp-for="Username"></label><input asp-for="Username" class="form-control" />
<button class="btn btn-primary mt-3">Email a reset link</button></form>
