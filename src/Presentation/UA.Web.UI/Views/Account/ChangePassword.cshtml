@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change password"; }
<h1>Change password</h1><form method="post"><div asp-validation-summary="All" class="text-danger"></div>
<label asp-for="OldPassword"></label><input asp-for="OldPassword" class="form-control" />
<label asp-for="NewPassword"></label><input asp-for="NewPassword" class="form-control" />
<label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" />
<button class="btn btn-primary mt-3">Save</button></form>
