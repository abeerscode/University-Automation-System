@model ResetPasswordViewModel
@{ ViewData["Title"] = "New password"; }
<h1>Choose a new password</h1><form method="post" asp-action="ResetPassword"><div asp-validation-summary="All" class="text-danger"></div>
<input asp-for="Username" type="hidden"/><input asp-for="Token" type="hidden" />
<label asp-for="Password"></label><input asp-for="Password" class="form-control" />
<label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" />
<button class="btn btn-primary mt-3">Change password</button></form>
