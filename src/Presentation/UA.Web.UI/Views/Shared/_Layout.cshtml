@using System.Security.Claims
@inject UA.Facade.Interface.Administration.IUserAccessFacade Access
@{
    var userId = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out int parsed) ? parsed : 0;
    var admin = userId > 0 && await Access.AllowedAsync(userId, "users.view");
    var audit = userId > 0 && await Access.AllowedAsync(userId, "audit.view");
    var approval = userId > 0 && await Access.AllowedAsync(userId, "approvals.record");
    var config = userId > 0 && await Access.AllowedAsync(userId, "config.manage");
    var notice = userId > 0 && await Access.AllowedAsync(userId, "notices.edit");
    var import = userId > 0 && await Access.AllowedAsync(userId, "imports.run");
    var templates = userId > 0 && await Access.AllowedAsync(userId, "templates.manage");
}
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] | UAS</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><header class="navbar navbar-expand-lg navbar-dark app-nav"><div class="container-fluid">
<a class="navbar-brand" asp-controller="Home" asp-area="" asp-action="Index">UAS <small>Administration</small></a>
<nav class="navbar-nav flex-row flex-wrap gap-3">
@if(admin){<a class="nav-link" asp-area="Administration" asp-controller="Users" asp-action="Index">Users</a><a class="nav-link" asp-area="Administration" asp-controller="Roles" asp-action="Index">Roles</a>}
@if(approval){<a class="nav-link" asp-area="Administration" asp-controller="Approvals" asp-action="Index">Approvals</a>}
@if(audit){<a class="nav-link" asp-area="Administration" asp-controller="Audit" asp-action="Index">Audit</a>}
@if(config){<a class="nav-link" asp-area="Administration" asp-controller="ConfigParameters" asp-action="Index">Configuration</a>}
@if(notice){<a class="nav-link" asp-area="Website" asp-controller="Notices" asp-action="Index">Notices</a>}
@if(import){<a class="nav-link" asp-area="Administration" asp-controller="DataImport" asp-action="Index">Import</a>}
@if(config){<a class="nav-link" asp-area="Administration" asp-controller="GradeScales" asp-action="Index">Grades</a><a class="nav-link" asp-area="Administration" asp-controller="MarkSchemes" asp-action="Index">Marks</a><a class="nav-link" asp-area="Administration" asp-controller="AttendanceScales" asp-action="Index">Attendance rules</a>}
@if(templates){<a class="nav-link" asp-area="Administration" asp-controller="NotificationTemplates" asp-action="Index">Templates</a>}
@if(userId > 0){<a class="nav-link" asp-area="" asp-controller="Notifications" asp-action="Index">Inbox</a><a class="nav-link" asp-area="" asp-controller="Jobs" asp-action="Index">Jobs</a>}
</nav><div class="ms-auto d-flex gap-2 align-items-center text-white small">
@if(userId > 0){ <span>@User.Identity?.Name</span><a class="btn btn-sm btn-outline-light" asp-area="" asp-controller="Account" asp-action="ChangePassword">Password</a>
<form method="post" asp-area="" asp-controller="Account" asp-action="Logout"><button class="btn btn-sm btn-light">Sign out</button></form> }
else{<a class="btn btn-sm btn-light" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a>}
</div></div></header>
<main class="container main-content">@if(TempData["Message"] is string message){<div class="alert alert-success">@message</div>}
@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
@RenderBody()</main><footer class="border-top container py-3 text-muted"><small>University Automation System · Administration &amp; Security Core</small></footer>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/form-guard.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)</body></html>
