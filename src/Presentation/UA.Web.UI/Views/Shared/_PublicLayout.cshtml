@inject UA.Facade.Interface.Website.IPublicWebsiteFacade PublicWebsite
@{var site=UA.Facade.Rules.Website.SiteProfile.Parse((await PublicWebsite.PageAsync("site-profile"))?.Content);}
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] | @site.Name</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/public.css" asp-append-version="true"/></head><body>
<header class="public-header"><div class="container"><a class="brand" asp-area="" asp-controller="Public" asp-action="Index">@if(UA.Facade.Rules.Website.PublicContent.LocalImage(site.Logo)){<img src="@site.Logo" alt="" width="40" height="40" class="me-2"/>}@site.Name</a><nav aria-label="Public navigation"><a asp-area="" asp-controller="Public" asp-action="Index">Home</a><a asp-area="" asp-controller="Public" asp-action="Page" asp-route-id="about">About</a><a asp-area="" asp-controller="Public" asp-action="Admission">Admission</a><a asp-area="" asp-controller="Public" asp-action="Notices">Notices</a><a asp-area="" asp-controller="Public" asp-action="Faculty">Faculty</a><a asp-area="" asp-controller="Public" asp-action="Result">Results</a><a asp-area="" asp-controller="Public" asp-action="Page" asp-route-id="contact">Contact</a><a asp-area="" asp-controller="Account" asp-action="Login">Portal login</a></nav></div></header>
<main class="container public-main">@RenderBody()</main><footer class="public-footer"><div class="container"><p>@site.Name</p><p>@site.Address @site.Email @site.Telephone</p>@if(UA.Facade.Rules.Website.PublicContent.Https(site.Facebook)){<a href="@site.Facebook" rel="noopener noreferrer">Facebook</a>} @if(UA.Facade.Rules.Website.PublicContent.Https(site.LinkedIn)){<a href="@site.LinkedIn" rel="noopener noreferrer">LinkedIn</a>}<p>University Automation System</p><a asp-area="Admission" asp-controller="Applicant" asp-action="Index">Applicant portal</a> · <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Portal/Dashboard">Student login</a> · <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Portal/FacultyDashboard">Faculty login</a> · <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Home/Index">Staff login</a></div></footer></body></html>
