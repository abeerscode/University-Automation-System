@model EventPage
@{ViewData["Title"]="Exam event";var e=Model.Event;}
<a asp-action="Index">Back to examinations</a><h1>@e.Type examination</h1><p>Term @e.TermId · @e.Start.ToString("dd MMM yyyy") – @e.End.ToString("dd MMM yyyy") · @e.Status</p>
@if(Model.Controller && e.Status=="Draft"){
<form asp-action="Generate" method="post" class="card card-body mb-3"><input type="hidden" name="id" value="@e.Id"/><h5>Generate routine</h5><p>Choose the daily exam window and slot length. Independent courses may run in parallel when their batches, sections, regular examinees and available exam halls do not conflict. Halls are assigned during seat generation.</p><div class="row g-2"><div class="col"><label>Day begins</label><input class="form-control" type="time" name="start" required/></div><div class="col"><label>Day ends</label><input class="form-control" type="time" name="end" required/></div><div class="col"><label>Exam duration (minutes)</label><input class="form-control" name="minutes" type="number" min="30" max="360" value="120" required/></div><div class="col align-self-end"><button class="btn btn-primary">Generate</button></div></div></form>}
@if(Model.Controller && e.Status=="Scheduled"){
<div class="d-flex gap-2 mb-3"><form asp-action="Queue" method="post"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="kind" value="Seat"/><button class="btn btn-primary">Check eligibility / generate seats</button></form>@if(e.Type is "Final" or "Special"){<form asp-action="Queue" method="post"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="kind" value="Publish"/><button class="btn btn-danger">Publish approved final results</button></form>}</div><p class="text-muted">Jobs run in the API worker. Re-run seat generation after a hold is released or fees are paid, before confirming any make-up clashes. Concurrent sittings use separate exam halls.</p>}
<h2 class="h4">Routine</h2><div class="table-responsive"><table class="table"><thead><tr><th>Course</th><th>Date</th><th>Time</th><th>Adjustment</th></tr></thead><tbody>@foreach(var s in Model.Sittings){<tr><td>@s.Course</td><td>@s.Date.ToString("yyyy-MM-dd")</td><td>@s.Start – @s.End</td><td>@if(Model.Controller && e.Status=="Scheduled" && !Model.Seats.Any(x=>x.SittingId==s.Id)){<form asp-action="Edit" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="sittingId" value="@s.Id"/><input type="date" name="date" value="@s.Date.ToString("yyyy-MM-dd")" required/><input type="time" name="start" value="@s.Start.ToString(@"hh\:mm")" required/><input type="time" name="end" value="@s.End.ToString(@"hh\:mm")" required/><button class="btn btn-sm btn-outline-primary">Save</button></form>}</td></tr>}</tbody></table></div>
<h2 class="h4">Eligibility holds</h2><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Course</th><th>Type</th><th>Reason</th><th>Release</th></tr></thead><tbody>@foreach(var h in Model.Holds){<tr><td>@h.Student</td><td>@h.Course</td><td>@h.Type</td><td>@h.Reason</td><td>@if(h.Released){<span>Released</span>}else if(h.CanRelease){<form asp-action="Release" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="holdId" value="@h.Id"/><input class="form-control" name="reason" required maxlength="255" placeholder="Reason"/><button class="btn btn-sm btn-outline-primary">Release</button></form>}else{<span>Held</span>}</td></tr>}</tbody></table></div>
<h2 class="h4">Seat plan</h2><p><a asp-action="SeatPlan" asp-route-id="@e.Id" asp-route-format="xlsx">Excel</a> · <a asp-action="SeatPlan" asp-route-id="@e.Id" asp-route-format="print">Print / PDF</a></p><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Course</th><th>Date</th><th>Time</th><th>Room</th><th>Seat</th>@if(Model.Controller){<th>Adjustment</th>}</tr></thead><tbody>@foreach(var s in Model.Seats.OrderBy(x=>x.Date).ThenBy(x=>x.Start).ThenBy(x=>x.Room).ThenBy(x=>x.Seat)){<tr><td>@s.Student</td><td>@s.Course @if(s.Retake){<span class="badge bg-secondary">Retake</span>} @if(s.Makeup){<span class="badge bg-info">Make-up</span>} @if(s.ClashConfirmed&&!s.Makeup){<span class="badge bg-warning text-dark">Awaiting make-up</span>}</td><td>@s.Date.ToString("yyyy-MM-dd")</td><td>@s.Start – @s.End</td><td>@s.Room</td><td>@s.Seat</td>@if(Model.Controller){<td>@if(e.Status=="Scheduled"&&!s.ClashConfirmed){<form asp-action="MoveSeat" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="sittingId" value="@s.SittingId"/><input type="hidden" name="studentId" value="@s.Student"/><select class="form-select" name="roomId" required>@foreach(var h in Model.Halls){<option value="@h.Id">@h.Label</option>}</select><input class="form-control" type="number" min="1" name="seatNo" required value="@s.Seat"/><button class="btn btn-sm btn-outline-primary">Move</button></form>}</td>}</tr>}</tbody></table></div>

@if(e.Type=="Final"&&e.Status=="Scheduled"){
<h2 class="h4 mt-4">Department-confirmed retake clashes and make-up seating</h2><p>Only department-confirmed clashes appear here. The system does not detect regular/retake conflicts automatically. Complete normal seat generation first.</p>
@foreach(var s in Model.Seats.Where(x=>x.Retake&&(x.CanConfirm||x.ClashConfirmed&&Model.Controller))){<div class="card card-body mb-2"><p>@s.Student — @s.Course — @(s.Makeup?"Make-up assigned":s.ClashConfirmed?"Confirmed; awaiting make-up":"Not confirmed")</p>
@if(s.CanConfirm&&!s.ClashConfirmed){<form asp-action="ConfirmClash" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="sittingId" value="@s.SittingId"/><input type="hidden" name="studentId" value="@s.Student"/><input name="reason" class="form-control" required maxlength="255" placeholder="Department-confirmed conflict"/><button class="btn btn-warning">Confirm clash</button></form>}
@if(Model.Controller&&s.ClashConfirmed){<form asp-action="AssignMakeup" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="sittingId" value="@s.SittingId"/><input type="hidden" name="studentId" value="@s.Student"/><input type="date" name="date" class="form-control" required/><select name="roomId" class="form-select" required>@foreach(var h in Model.Halls){<option value="@h.Id">@h.Label</option>}</select><input type="number" name="seatNo" min="1" class="form-control" required placeholder="Seat"/><button class="btn btn-primary">Assign make-up seat</button></form>}
</div>}}
