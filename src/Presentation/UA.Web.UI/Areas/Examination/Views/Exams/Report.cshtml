@model ResultRow[]
@inject UA.Facade.Interface.Administration.IUserAccessFacade Access
@{ViewData["Title"]="Published results";int termId=ViewBag.TermId;int? batchId=ViewBag.BatchId;var actor=int.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,out var a)?a:0;bool correct=actor>0&&(await Access.ForUserAsync(actor)).Assignments.Any(x=>x.RoleName==UA.Framework.Constants.RoleNames.Controller);}
<a asp-action="Index">Back to examinations</a><h1>Published grade / tabulation report</h1><p>Term @termId</p><p><a asp-action="Export" asp-route-termId="@termId" asp-route-batchId="@batchId" asp-route-format="xlsx">Excel</a> · <a asp-action="Export" asp-route-termId="@termId" asp-route-batchId="@batchId" asp-route-format="pdf">PDF</a> · <a asp-action="Export" asp-route-termId="@termId" asp-route-batchId="@batchId" asp-route-format="print">Print</a></p>
<p><a asp-action="Backlog" asp-route-termId="@termId" asp-route-batchId="@batchId">Failed course shortlist</a> · <a asp-action="Backlog" asp-route-termId="@termId" asp-route-batchId="@batchId" asp-route-format="xlsx">Shortlist Excel</a>
@if(batchId.HasValue){<span> · </span><a asp-action="Merit" asp-route-termId="@termId" asp-route-batchId="@batchId">Semester GPA merit list</a><span> · </span><a asp-action="Merit" asp-route-termId="@termId" asp-route-batchId="@batchId" asp-route-format="xlsx">Merit Excel</a><span> · </span><a asp-action="Merit" asp-route-termId="@termId" asp-route-batchId="@batchId" asp-route-format="pdf">Merit PDF</a>}
</p>
<div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Course</th><th>Total</th><th>Grade</th><th>Status</th><th>Version</th>@if(correct){<th>Correction</th>}</tr></thead><tbody>@foreach(var r in Model.OrderBy(x=>x.Student).ThenBy(x=>x.Course)){<tr><td><a asp-action="Student" asp-route-id="@r.Student">@r.Student</a></td><td>@r.Course</td><td>@r.Total</td><td>@r.Grade @(r.Replaced?"(R)":"")</td><td>@r.Status</td><td>@r.Version</td>@if(correct){<td><details><summary>Correct</summary><form asp-action="Correct" method="post" class="d-grid gap-1"><input type="hidden" name="id" value="@termId"/><input type="hidden" name="resultId" value="@r.Id"/><label>Total <input class="form-control" type="number" name="total" min="0" max="100" step="0.01" required value="@r.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)"/></label><label>Status <select class="form-select" name="status"><option>Normal</option><option>Absent</option><option>Withheld</option><option>Expelled</option></select></label><label>Approved ResultCorrection reference ID <input type="number" min="1" name="approvalId" class="form-control" required/></label><input class="form-control" name="reason" maxlength="255" required placeholder="Correction reason"/><button class="btn btn-sm btn-warning">Create new result version</button></form></details></td>}</tr>}</tbody></table></div>
