@model StudentExamPage
@{ViewData["Title"]="Exams and results";}
<h1>Exams and results</h1><p>Student ID: @Model.Student</p>
@if(Model.SpecialEvents is { Length: > 0 }){<h2 class="h4">Special retake dates</h2><ul>@foreach(var ev in Model.SpecialEvents){<li>@ev.Start.ToString("dd MMM yyyy") · @ev.Status · Seat/admit card subject to eligibility.</li>}</ul>}
<h2 class="h4">Examination holds</h2><table class="table"><thead><tr><th>Course</th><th>Type</th><th>Reason</th><th>Status</th></tr></thead><tbody>@foreach(var h in Model.Holds){<tr><td>@h.Course</td><td>@h.Type</td><td>@h.Reason</td><td>@(h.Released?"Released":"Held")</td></tr>}</tbody></table>
<h2 class="h4">My routine and seats</h2>@foreach(var id in Model.IsOwn?Model.Seats.Select(x=>x.EventId).Distinct():Enumerable.Empty<int>()){<p>Event @id · <a asp-action="AdmitCard" asp-route-eventId="@id">Download admit card PDF</a> · <a asp-action="AdmitCard" asp-route-eventId="@id" asp-route-format="print">Print</a></p>}
<table class="table"><thead><tr><th>Event</th><th>Course</th><th>Date</th><th>Time</th><th>Room</th><th>Seat</th></tr></thead><tbody>@foreach(var s in Model.Seats){<tr><td>@s.EventId</td><td>@s.Course</td><td>@s.Date.ToString("yyyy-MM-dd")</td><td>@s.Start – @s.End</td><td>@s.Room</td><td>@s.Seat</td></tr>}</tbody></table>
<h2 class="h4">Published results</h2><p><a asp-action="Transcript" asp-route-studentId="@Model.Student" asp-route-format="pdf">Transcript PDF</a> · <a asp-action="Transcript" asp-route-studentId="@Model.Student" asp-route-format="xlsx">Excel</a> · <a asp-action="Transcript" asp-route-studentId="@Model.Student" asp-route-format="print">Print</a></p>
<table class="table"><thead><tr><th>Term</th><th>Course</th><th>Credits</th><th>Total</th><th>Grade</th><th>Points</th><th>Status</th></tr></thead><tbody>@foreach(var r in Model.Results.OrderBy(x=>x.TermId)){<tr><td>@r.TermId</td><td>@r.Course</td><td>@r.Credits</td><td>@(r.Status is "Withheld" or "Expelled"?"—":r.Total.ToString())</td><td>@r.Grade @(r.Replaced?"(R)":"")</td><td>@(r.Status is "Withheld" or "Expelled"?"—":r.Points.ToString())</td><td>@r.Status</td></tr>}</tbody></table>
<h2 class="h4">Semester GPA and CGPA</h2><table class="table"><thead><tr><th>Term</th><th>Semester</th><th>Earned credits</th><th>GPA</th><th>CGPA</th></tr></thead><tbody>@foreach(var g in Model.Gpas.OrderBy(x=>x.TermId)){<tr><td>@g.TermId</td><td>@g.Semester</td><td>@g.Earned</td><td>@g.Gpa</td><td>@g.Cgpa</td></tr>}</tbody></table>
