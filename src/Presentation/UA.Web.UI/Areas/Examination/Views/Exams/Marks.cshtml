@model MarksPage
@{ViewData["Title"]="Marks";bool edit=Model.CanEnter&&(Model.Status=="Draft"||Model.Status=="Returned");int index=0;}
<a asp-action="Index">Back to examinations</a><h1>@Model.Course</h1><p>Offering @Model.OfferingId · @Model.Status</p>
@if(edit){<div class="card card-body mb-3"><a asp-action="Template" asp-route-id="@Model.OfferingId">Download Excel entry template</a><form asp-action="Import" method="post" enctype="multipart/form-data" class="d-flex gap-2 mt-2"><input type="hidden" name="id" value="@Model.OfferingId"/><input type="file" name="file" accept=".xlsx,.csv" required class="form-control"/><button class="btn btn-outline-primary">Import marks</button></form></div>}
<form asp-action="Save" method="post"><input type="hidden" name="id" value="@Model.OfferingId"/><div class="table-responsive"><table class="table table-bordered align-middle"><thead><tr><th>Student</th>@foreach(var p in Model.Parts){<th>@p.Name (@p.Maximum)</th>}</tr></thead><tbody>
@foreach(var s in Model.Students.OrderBy(x=>x.EnrollmentType).ThenBy(x=>x.Student)){<tr><td>@s.Student<br/>@s.Name<br/><span class="badge bg-secondary">@s.EnrollmentType</span></td>@foreach(var p in Model.Parts){var cell=Model.Cells.FirstOrDefault(c=>c.EnrollmentId==s.Id&&c.ComponentId==p.Id);<td>@if(p.Retake!=(s.EnrollmentType=="Retake")){<span class="text-muted">—</span>}else if(edit&&!p.Attendance&&(!p.Retake||Model.CanEnterRetake)){<input type="hidden" name="input[@index].EnrollmentId" value="@s.Id"/><input type="hidden" name="input[@index].ComponentId" value="@p.Id"/><input class="form-control" style="min-width:90px" type="number" min="0" max="@p.Maximum.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" name="input[@index].Marks" value="@(cell?.Marks?.ToString(System.Globalization.CultureInfo.InvariantCulture))"/><label class="small"><input type="checkbox" name="input[@index].Absent" value="true" checked="@(cell?.Absent==true)"/> Absent</label>index++;}else if(p.Attendance&&cell is null){<span class="text-muted">Calculated on submit</span>}else{<span>@(cell?.Absent==true?"Absent":cell?.Marks?.ToString()??"Missing")</span>}</td>}</tr>}
</tbody></table></div>@if(edit){<button class="btn btn-primary">Save draft</button>}</form>
<div class="mt-3 d-flex gap-2 flex-wrap">@if(edit){<form asp-action="Transition" method="post"><input type="hidden" name="id" value="@Model.OfferingId"/><input type="hidden" name="actionName" value="Submit"/><button class="btn btn-success">Submit saved marks</button></form>}
@if(Model.CanVerify&&Model.Status=="Submitted"){<form asp-action="Transition" method="post"><input type="hidden" name="id" value="@Model.OfferingId"/><button name="actionName" value="Verify" class="btn btn-success">Verify</button></form><form asp-action="Transition" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@Model.OfferingId"/><input name="comment" required maxlength="255" placeholder="Return comment" class="form-control"/><button name="actionName" value="ReturnHead" class="btn btn-outline-danger">Return</button></form>}
@if(Model.CanApprove&&Model.Status=="Verified"){<form asp-action="Transition" method="post"><input type="hidden" name="id" value="@Model.OfferingId"/><button name="actionName" value="Approve" class="btn btn-success">Approve</button></form><form asp-action="Transition" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@Model.OfferingId"/><input name="comment" required maxlength="255" placeholder="Return comment" class="form-control"/><button name="actionName" value="ReturnController" class="btn btn-outline-danger">Return</button></form>}</div>

@if(Model.CanApprove && Model.Status=="Approved"){
<h2 class="h4 mt-4">Pre-publication result dispositions</h2><p>Set Withheld or Expelled before publication when authorized. Every change requires a reason.</p>
<table class="table"><thead><tr><th>Student</th><th>Current disposition</th><th>Change disposition</th></tr></thead><tbody>@foreach(var s in Model.Students){<tr><td>@s.Student</td><td>@s.Disposition</td><td><form asp-action="Disposition" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@Model.OfferingId"/><input type="hidden" name="enrollmentId" value="@s.Id"/><select name="status" class="form-select"><option>Normal</option><option>Withheld</option><option>Expelled</option></select><input name="reason" class="form-control" maxlength="255" required placeholder="Reason"/><button class="btn btn-outline-primary">Save</button></form></td></tr>}</tbody></table>}
