@model ExamHome
@{ViewData["Title"]="Examination operations";}
<h1>Examination operations</h1>
@if(Model.Controller){<p><a asp-area="Student" asp-controller="Lifecycle" asp-action="Shortlist">Latest retake shortlist by course</a></p>}
@if(Model.Controller){
<form asp-action="Create" method="post" class="card card-body mb-3"><h5>Create examination event from calendar</h5><div class="row g-2"><div class="col"><select class="form-select" name="termId" required>@foreach(var t in Model.Terms){<option value="@t.Id">@t.Label</option>}</select></div><div class="col"><select class="form-select" name="type"><option>Midterm</option><option>Final</option></select></div><div class="col"><button class="btn btn-primary">Create event</button></div></div></form>}
@if(Model.Controller){<form asp-action="CreateSpecial" method="post" class="card card-body mb-3"><h5>Create special last-semester retake event</h5><label>Term</label><select name="termId" class="form-select" required>@foreach(var t in Model.Terms){<option value="@t.Id">@t.Label</option>}</select><label>Published exam date</label><input type="date" name="date" class="form-control" required/><button class="btn btn-primary mt-2">Create special event</button></form>}
<h2 class="h4">Exam events</h2><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Term</th><th>Type</th><th>Period</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var e in Model.Events){<tr><td>@e.TermId</td><td>@e.Type</td><td>@e.Start.ToString("dd MMM yyyy") – @e.End.ToString("dd MMM yyyy")</td><td>@e.Status</td><td><a asp-action="Event" asp-route-id="@e.Id">Open</a></td></tr>}</tbody></table></div>
<h2 class="h4">Marks and review</h2><table class="table"><thead><tr><th>Offering</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var o in Model.Offerings){<tr><td>@o.Label</td><td>@o.Status</td><td><a asp-action="Marks" asp-route-id="@o.Id">Open marks</a></td></tr>}</tbody></table>
@if(Model.Events.Length>0){<h2 class="h4">Published reports</h2><form asp-action="Report" method="get" class="row g-2"><div class="col"><select name="termId" class="form-select">@foreach(var t in Model.Terms){<option value="@t.Id">@t.Label</option>}</select></div><div class="col"><input class="form-control" name="batchId" type="number" placeholder="Admission batch ID (optional)" /></div><div class="col"><button class="btn btn-outline-primary">View report</button></div></form>}
