@model DepartmentEditForm
@{ ViewData["Title"] = "Department"; DepartmentDto? d = ViewBag.Department; }
<h1>@(d?.Code) — Department and program</h1>
<p class="text-muted">Department code @(d?.Code) and ID digits @(d?.IdCode) cannot be changed.</p>
<div class="row g-4"><div class="col-md-6"><div class="card"><div class="card-body"><h2 class="h5">Department</h2>
<form asp-action="Edit" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden" />
<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
<div class="mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Active</option><option>Inactive</option></select></div>
<button class="btn btn-primary">Save department</button></form></div></div></div>
<div class="col-md-6"><div class="card"><div class="card-body"><h2 class="h5">Bachelor program</h2>
<form asp-action="Program" method="post"><input type="hidden" name="DepartmentId" value="@Model.Id" />
<div class="mb-3"><label for="programName" class="form-label">Program name</label><input id="programName" name="Name" value="@(d?.ProgramName)" required maxlength="100" class="form-control" /></div>
<div class="mb-3"><label for="total" class="form-label">Program credits</label><input id="total" type="number" name="TotalCredits" value="@(d?.TotalCredits ?? 120)" min="96" max="144" class="form-control" /></div>
<p class="small text-muted">A program has eight semesters; credit totals cannot be changed after its curriculum has been defined.</p>
<button class="btn btn-primary">Save program</button></form></div></div></div></div>
<div class="mt-3"><a class="btn btn-outline-secondary" asp-action="Settings" asp-route-departmentId="@Model.Id">Academic settings</a> <a asp-action="Index">Back to departments</a></div>
