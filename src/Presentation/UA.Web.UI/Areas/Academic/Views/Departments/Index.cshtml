@model IReadOnlyList<DepartmentDto>
@{ ViewData["Title"] = "Departments and programs"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Departments and programs</h1></div>
<p class="text-muted">One bachelor program per department; eight semesters. Codes and student-ID digits remain stable.</p>
<table class="table table-striped table-hover"><thead><tr><th>Code</th><th>Department</th><th>Program</th><th>Total credits</th><th>Status</th><th></th></tr></thead><tbody>
@foreach(var d in Model){<tr><td>@d.Code</td><td>@d.Name</td><td>@(d.ProgramName ?? "Not configured")</td><td>@d.TotalCredits</td><td>@d.Status</td><td><a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">Manage</a></td></tr>}
</tbody></table>
