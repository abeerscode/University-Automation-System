@model OfferingDetail
@{ViewData["Title"]="Offering details";var o=Model.Offering;}
<a asp-action="Index" asp-route-batchId="@o.BatchId" asp-route-termId="@o.TermId">Back to offerings</a>
<h1>@o.Course</h1><p>Section @o.Section · Semester @o.Semester · @o.Status</p>
@if(o.CanManage){<form asp-action="Status" method="post" class="d-flex gap-2 mb-3"><input type="hidden" name="id" value="@o.Id"/><select name="status" class="form-select w-auto"><option>Planned</option><option>Active</option><option>Closed</option></select><button class="btn btn-outline-primary">Update status</button></form>}
<h2 class="h4">Teacher assignments</h2>
<table class="table"><thead><tr><th>Teacher</th><th>Assigned</th><th>Ended</th><th></th></tr></thead><tbody>
@foreach(var a in Model.Teachers){<tr><td>@a.Teacher @if(a.RetakeMarker){<span class="badge bg-secondary">Retake marker</span>}</td><td>@a.Assigned.ToString("yyyy-MM-dd")</td><td>@a.Ended?.ToString("yyyy-MM-dd")</td><td>@if(o.CanAssign && a.Ended is null){<form asp-action="Assign" method="post"><input type="hidden" name="id" value="@o.Id"/><input type="hidden" name="facultyId" value="@a.FacultyId"/><input type="hidden" name="end" value="true"/><button class="btn btn-sm btn-outline-danger">End assignment</button></form>
@if(!a.RetakeMarker){<form asp-action="Designate" method="post"><input type="hidden" name="id" value="@o.Id"/><input type="hidden" name="facultyId" value="@a.FacultyId"/><button class="btn btn-sm btn-outline-primary mt-1">Designate retake marker</button></form>}}</td></tr>}
</tbody></table>
@if(o.CanAssign){<form asp-action="Assign" method="post" class="d-flex gap-2 mb-4"><input type="hidden" name="id" value="@o.Id"/><select name="facultyId" class="form-select" required><option value="">Choose active teacher (any department)</option>@foreach(var f in Model.Faculty){<option value="@f.Id">@f.Label</option>}</select><button class="btn btn-primary">Assign</button></form>}
@if(Model.History.Count>0){<h3 class="h5">Previous assignment intervals</h3><table class="table"><thead><tr><th>Teacher</th><th>Archived interval</th><th>Logged at</th></tr></thead><tbody>@foreach(var a in Model.History){<tr><td>@a.Teacher</td><td>@a.PreviousInterval</td><td>@a.LoggedAt.ToString("yyyy-MM-dd HH:mm")</td></tr>}</tbody></table>}
<h2 class="h4">Class routine</h2><p>Weekdays: Monday = 1, Sunday = 7. All assigned teachers are checked for clashes.</p>
<table class="table"><thead><tr><th>Slot</th><th>Day</th><th>Room</th><th>Time</th></tr></thead><tbody>@foreach(var r in Model.Routine){<tr><td>@r.Id</td><td>@r.Day</td><td>@r.Room</td><td>@r.Start.ToString(@"hh\:mm") – @r.End.ToString(@"hh\:mm")</td></tr>}</tbody></table>
@if(o.CanSchedule){<form asp-action="Routine" method="post" class="row g-2 mb-4"><input type="hidden" name="id" value="@o.Id"/><div class="col-md-2"><label>Slot</label><select name="routineId" class="form-select"><option value="0">New</option>@foreach(var r in Model.Routine){<option value="@r.Id">@r.Id</option>}</select></div><div class="col-md-3"><label>Room</label><select name="roomId" class="form-select" required><option value="">Select</option>@foreach(var r in Model.Rooms){<option value="@r.Id">@r.Label</option>}</select></div><div class="col-md-2"><label>Day</label><select name="day" class="form-select">@for(int i=1;i<=7;i++){<option value="@i">@i</option>}</select></div><div class="col-md-2"><label>Start</label><input name="start" type="time" class="form-control" required/></div><div class="col-md-2"><label>End</label><input name="end" type="time" class="form-control" required/></div><div class="col-md-1 align-self-end"><button class="btn btn-primary">Save</button></div></form>}
<h2 class="h4">Enrollment and attendance report</h2><a asp-action="ExportOffering" asp-route-id="@o.Id">Export CSV</a> · <a asp-action="ExportOffering" asp-route-id="@o.Id" asp-route-format="xlsx">Export Excel</a> · <a asp-action="ExportOffering" asp-route-id="@o.Id" asp-route-format="print">Print / save PDF</a>
@foreach(var group in Model.Students.GroupBy(s=>s.Type)){<h3 class="h5 mt-3">@group.Key</h3><div class="table-responsive"><table class="table table-striped"><thead><tr><th>ID</th><th>Name</th><th>Status</th><th>Prerequisite</th><th>Present / total</th><th>Attendance</th><th>Marks (scale version)</th></tr></thead><tbody>@foreach(var s in group){<tr><td>@s.StudentId</td><td>@s.Name</td><td>@s.Status</td><td>@(s.PrerequisiteWarning?"Not passed":"—")</td><td>@s.Present / @s.Classes</td><td>@(s.Percent?.ToString("F2")??"—") @(s.Shortage?"% — shortage":"")</td><td>@s.Marks (v@(s.ScaleVersion))</td></tr>}</tbody></table></div>}
@if(Model.Students.Count==0){<p>No enrollments yet.</p>}
