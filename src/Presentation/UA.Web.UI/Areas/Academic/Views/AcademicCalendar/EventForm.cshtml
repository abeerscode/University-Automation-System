@model CalendarEventForm
@{
    ViewData["Title"] = Model.Id == 0 ? "Add calendar event" : "Edit calendar event";
}
<h1>@ViewData["Title"]</h1>
<form method="post" asp-action="SaveEvent" class="card p-4" style="max-width:650px">
    <div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden" /><input
    asp-for="TermId" type="hidden" />
    <div class="mb-3"><label asp-for="Type" class="form-label"></label><select asp-for="Type" class="form-select">
        @foreach (var type in new[] { "Class period", "Midterm period", "Final period", "Make-up days", "Result date", "Fee deadline", "Break" })
        {
            <option value="@type">@type</option>
        }
    </select></div>
    <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" />
    </div>
    <div class="row">
        <div class="col mb-3"><label asp-for="Starts" class="form-label">Start date</label><input asp-for="Starts"
                                                                                                      type="date" class="form-control" /></div>
            <div class="col mb-3"><label asp-for="Ends" class="form-label">End date</label><input asp-for="Ends" type="date"
                                                                                                      class="form-control" /></div>
            </div>
            <button class="btn btn-primary">Save event</button>
        </form>