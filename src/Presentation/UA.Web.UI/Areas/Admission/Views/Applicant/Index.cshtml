@inject UA.Framework.Time.IClock Clock
@model IReadOnlyList<AdmissionRow>
@{ViewData["Title"]="My applications";var circulars=(IReadOnlyList<CircularRow>)ViewBag.Circulars;}
<h1>Applicant portal</h1><p>Application and enrollment fees are invoiced only. Online payment is not available.</p><p><a asp-area="" asp-controller="Account" asp-action="VerifyCode">Verify email</a></p>
<h2 class="h4">My applications</h2><div class="table-responsive"><table class="table"><thead><tr><th>Applicant ID</th><th>Department</th><th>Status</th><th>Result</th><th>Actions</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.ApplicantId</td><td>@a.Department</td><td>@a.Status</td><td>@a.Marks @a.Rank @a.Selection</td><td><a asp-action="Invoice" asp-route-id="@a.Id">Invoice</a>@if(a.ApplicationPaid){<span> | </span><a asp-action="AdmitCard" asp-route-id="@a.Id">Admit card</a>}@if(a.Status=="Result published"&&(a.Selection=="Selected"||a.Selection=="Replacement")){<form asp-action="EnrollmentInvoice" method="post"><input type="hidden" name="id" value="@a.Id"/><button class="btn btn-sm btn-outline-primary">Generate enrollment invoice</button></form>}</td></tr>}</tbody></table></div>
<h2 class="h4">Admission circulars</h2>@foreach(var c in circulars.Where(c=>c.Status=="Published"&&Clock.Today>=c.Open&&Clock.Today<=c.Close)){<div class="card mb-2"><div class="card-body"><h3 class="h5">Intake @c.Year</h3><p>Applications: @c.Open.ToString("d") – @c.Close.ToString("d")</p>@if(Model.All(a=>a.CircularId!=c.Id)){<a asp-action="Apply" asp-route-id="@c.Id" class="btn btn-primary">Apply</a>}</div></div>}
