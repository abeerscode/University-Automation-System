@model CircularRow
@{ViewData["Title"]="Admission application";}
<h1>Apply for intake @Model.Year</h1><form asp-action="Apply" method="post" enctype="multipart/form-data" class="row g-3"><input type="hidden" name="id" value="@Model.Id"/>
<div class="col-md-6"><label>Department</label><select name="departmentId" class="form-select" required>@foreach(var s in Model.Seats){<option value="@s.DepartmentId">@s.Department (@s.Seats seats)</option>}</select></div>
<div class="col-md-6"><label>Full name</label><input name="name" required maxlength="100" class="form-control"/></div><div class="col-md-6"><label>Date of birth</label><input name="birth" type="date" required class="form-control"/></div><div class="col-md-6"><label>Gender</label><select name="gender" class="form-select"><option>Male</option><option>Female</option><option>Other</option></select></div><div class="col-12"><label>Address</label><textarea name="address" required maxlength="255" class="form-control"></textarea></div>
<div class="col-md-6"><label>Guardian name</label><input name="guardian" required maxlength="100" class="form-control"/></div><div class="col-md-6"><label>Guardian phone</label><input name="guardianPhone" type="tel" required maxlength="20" class="form-control"/></div>
@foreach(var level in new[]{"ssc","hsc"}){<div class="col-md-4"><label>@level.ToUpperInvariant() board</label><input name="@(level+"Board")" required maxlength="30" class="form-control"/></div><div class="col-md-4"><label>@level.ToUpperInvariant() roll</label><input name="@(level+"Roll")" required maxlength="20" class="form-control"/></div><div class="col-md-4"><label>@level.ToUpperInvariant() GPA (0–5)</label><input name="@(level+"Gpa")" type="number" min="0" max="5" step="0.01" required class="form-control"/></div>}
<div class="col-md-6"><label>Photo (JPEG/PNG, 1 MB)</label><input name="photo" type="file" accept="image/jpeg,image/png" required class="form-control"/></div><div class="col-md-6"><label>Optional certificate (PDF, 5 MB)</label><input name="certificate" type="file" accept="application/pdf" class="form-control"/></div><div class="col-12"><label><input type="checkbox" name="consent" value="true" required/> I consent to the use of my information and documents for admission, identity verification and academic administration. Non-enrolled applicant records are subject to the university retention policy.</label></div><div class="col-12"><button class="btn btn-primary">Submit and generate application invoice</button></div></form>
