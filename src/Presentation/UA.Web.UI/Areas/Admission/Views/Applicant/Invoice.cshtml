@model AdmissionInvoice
@{ViewData["Title"]="Admission invoice";}
<h1>Admission invoice</h1><p>Reference: ADM-@Model.Year-@Model.ApplicationId</p><p>Applicant: @Model.ApplicantId · @Model.Name</p><p class="alert alert-info">This is an invoice, not a receipt or payment confirmation. No online payment method is enabled.</p><div class="table-responsive"><table class="table"><thead><tr><th>Due ID</th><th>Fee</th><th>Deadline</th><th>Amount (BDT)</th><th>Confirmed paid</th><th>Balance</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td>@line.DueId</td><td>@line.Fee</td><td>@line.Deadline.ToString("d")</td><td>@line.Amount.ToString("F2")</td><td>@line.Paid.ToString("F2")</td><td>@line.Balance.ToString("F2")</td></tr>}</tbody></table></div><h2 class="h5">Outstanding: BDT @Model.Balance.ToString("F2")</h2><button type="button" data-print-document class="btn btn-outline-secondary no-print">Print / Save PDF</button>
