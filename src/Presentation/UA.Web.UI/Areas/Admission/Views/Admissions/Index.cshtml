@model IReadOnlyList<CircularRow>
@{ViewData["Title"]="Admission circulars";var departments=(IReadOnlyList<AdmissionSeat>)ViewBag.Departments;}
<h1>Admission circulars</h1><p class="text-muted">Create and publish one circular per intake. Published information appears on the university website.</p>
<div class="card mb-4"><div class="card-body"><h2 class="h5">Create draft</h2><form asp-action="Create" method="post" class="row g-3">
<div class="col-md-3"><label class="form-label">Intake year</label><input name="year" type="number" min="2000" max="2100" required class="form-control" /></div>
@foreach(var f in new[]{("open","Application opens"),("close","Application closes"),("test","Test date"),("result","Result date"),("deadline","Enrollment deadline")}){<div class="col-md-3"><label class="form-label">@f.Item2</label><input name="@f.Item1" type="date" required class="form-control" /></div>}
<div class="col-md-6"><label class="form-label">Test venue</label><input name="venue" required maxlength="150" class="form-control" /></div>
@foreach(var d in departments){<div class="col-md-3"><label class="form-label">@d.Department seats</label><input type="hidden" name="departmentIds" value="@d.DepartmentId"/><input name="seats" type="number" min="1" max="999" value="120" required class="form-control"/></div>}
<div class="col-12"><button class="btn btn-primary">Create circular</button></div></form></div></div>
<div class="table-responsive"><table class="table"><thead><tr><th>Intake</th><th>Application</th><th>Test</th><th>Enrollment deadline</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Year</td><td>@c.Open.ToString("d") – @c.Close.ToString("d")</td><td>@c.Test.ToString("d") · @c.Venue</td><td>@c.Deadline.ToString("d")</td><td>@c.Status</td><td><a class="btn btn-outline-secondary btn-sm" asp-action="Applications" asp-route-id="@c.Id">Applications</a>@if(c.Status=="Draft"){<form asp-action="Publish" method="post" class="d-inline"><input type="hidden" name="id" value="@c.Id"/><button class="btn btn-primary btn-sm">Publish</button></form>}</td></tr>}</tbody></table></div>

<h2 class="h4">Manage circular dates</h2>
@foreach(var c in Model){<details class="card card-body mb-2"><summary>@c.Year — @c.Status</summary><form asp-action="Edit" method="post" class="row g-2 mt-2"><input type="hidden" name="id" value="@c.Id"/>
@foreach(var f in new[]{("close","Application closes",c.Close),("test","Test date",c.Test),("result","Result date",c.Result),("deadline","Enrollment deadline",c.Deadline)}){<div class="col-md-3"><label class="form-label">@f.Item2</label><input name="@f.Item1" type="date" value="@f.Item3.ToString("yyyy-MM-dd")" required class="form-control"/></div>}
<div class="col-md-6"><label>Venue</label><input name="venue" value="@c.Venue" required maxlength="150" class="form-control"/></div><div class="col-md-6"><label>Reason</label><input name="reason" required maxlength="255" class="form-control"/></div><div><button class="btn btn-primary">Save changes</button></div></form>
@if(c.Status=="Published"){<form asp-action="Close" method="post" class="mt-3"><input type="hidden" name="id" value="@c.Id"/><label>Reason for closing applications</label><input name="reason" maxlength="255" required class="form-control"/><button class="btn btn-outline-danger mt-2">Close applications</button></form>}</details>}
