@model IReadOnlyList<AdmissionRow>
@{ViewData["Title"]="Admission applications";int id=ViewBag.CircularId;}
<h1>Applications</h1><p class="alert alert-info">Invoice-only mode: no payment gateway or payment confirmation button. Only verified settlements can enable admit cards, merit selection and enrollment.</p>
<form asp-action="Applications" method="get" class="row g-2 mb-3"><input type="hidden" name="id" value="@id"/><div class="col-md-4"><label>Department</label><select name="departmentId" class="form-select"><option value="">All departments</option>@foreach(var d in (IReadOnlyList<AdmissionSeat>)ViewBag.Departments){<option value="@d.DepartmentId" selected="@(ViewBag.DepartmentId==d.DepartmentId)">@d.Department</option>}</select></div><div class="col-md-4"><label>Status</label><select name="status" class="form-select"><option value="">All statuses</option>@foreach(var status in new[]{"Submitted","Paid","Result published","Enrolled","Selected"}){<option value="@status" selected="@(ViewBag.Status==status)">@status</option>}</select></div><div class="col-md-4 align-self-end"><button class="btn btn-outline-primary">Filter</button></div></form>
<div class="d-flex gap-2 flex-wrap mb-3"><a asp-action="Index" class="btn btn-outline-secondary">Circulars</a><form asp-action="Export" method="post"><input type="hidden" name="id" value="@id"/><input type="hidden" name="departmentId" value="@ViewBag.DepartmentId"/><input type="hidden" name="status" value="@ViewBag.Status"/><button class="btn btn-outline-primary">Excel report</button></form><form asp-action="ExportPdf" method="post"><input type="hidden" name="id" value="@id"/><input type="hidden" name="departmentId" value="@ViewBag.DepartmentId"/><input type="hidden" name="status" value="@ViewBag.Status"/><button class="btn btn-outline-primary">PDF report</button></form><a asp-action="Template" asp-route-id="@id" class="btn btn-outline-primary">Result template</a><button type="button" data-print-document class="btn btn-outline-secondary no-print">Print / Save PDF</button></div>
<form asp-action="Import" method="post" enctype="multipart/form-data" class="mb-3"><input type="hidden" name="id" value="@id"/><label>Test results (ApplicantId, Marks, Rank)</label><input type="file" name="upload" accept=".csv,.xlsx" required class="form-control"/><button class="btn btn-primary mt-2">Validate and import</button></form>
<form asp-action="PublishMerit" method="post" class="mb-3"><input type="hidden" name="id" value="@id"/><button class="btn btn-outline-primary">Publish merit and selection list</button></form>
<div class="table-responsive"><table class="table"><thead><tr><th>ID / applicant</th><th>Department</th><th>Status</th><th>Marks / rank</th><th>Selection</th><th>Fees</th><th>Documents</th><th>Actions</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.ApplicantId · @a.Name</td><td>@a.Department</td><td>@a.Status</td><td>@a.Marks / @a.Rank</td><td>@a.Selection</td><td>Application: @(a.ApplicationPaid?"Cleared":"Unpaid")<br/>Enrollment: @(a.EnrollmentPaid?"Cleared":"Not cleared")</td><td>@(a.Verified?"Verified":"Pending")</td><td><a asp-action="Invoice" asp-route-id="@a.Id">Invoice</a> | <a asp-action="Documents" asp-route-id="@a.Id">Documents</a>
@if(a.Status=="Result published"&&(a.Selection=="Selected"||a.Selection=="Replacement")&&a.Verified&&a.ApplicationPaid&&a.EnrollmentPaid){<form asp-action="Confirm" method="post"><input type="hidden" name="id" value="@a.Id"/><button class="btn btn-sm btn-primary">Confirm enrollment</button></form>}
@if(a.Selection=="Not selected"){<form asp-action="Replace" method="post"><input type="hidden" name="id" value="@a.Id"/><input type="hidden" name="circularId" value="@id"/><input name="reference" maxlength="30" required placeholder="Approval reference" class="form-control form-control-sm"/><button class="btn btn-outline-secondary btn-sm">Consider replacement</button></form>}</td></tr>}</tbody></table></div>
