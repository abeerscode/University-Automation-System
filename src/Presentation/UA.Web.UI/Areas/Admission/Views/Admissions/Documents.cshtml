@model IReadOnlyList<ApplicantDocumentRow>
@{ViewData["Title"]="Applicant documents";int id=ViewBag.ApplicationId;}
<h1>Applicant documents</h1><p>Verify original physical documents before recording the outcome.</p><ul>@foreach(var d in Model){<li><a asp-action="Download" asp-route-id="@id" asp-route-documentId="@d.Id">@d.Type (@d.Mime)</a></li>}</ul><form asp-action="Verify" method="post"><input type="hidden" name="id" value="@id"/><button class="btn btn-primary">Record physical verification</button></form>
