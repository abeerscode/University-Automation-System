@{ViewData["Title"]="Correct approval";}
<h1>Correct approval</h1><p>This adds a new approval record and preserves the original record.</p>
<form method="post" asp-route-id="@ViewBag.ApprovalId">
<label>Status</label><select name="status" class="form-select"><option>Approved</option><option>Rejected</option><option>Pending</option></select>
<label>Scan path</label><input name="scanPath" class="form-control" />
<button class="btn btn-primary">Create superseding record</button></form>
