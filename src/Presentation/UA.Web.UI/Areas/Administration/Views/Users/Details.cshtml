@model UA.Facade.DTO.Administration.UserDto
@{ViewData["Title"]="User details";}
<h1>@Model.Username</h1><dl class="row"><dt class="col-sm-2">Email</dt><dd class="col-sm-10">@Model.Email</dd>
<dt class="col-sm-2">Mobile</dt><dd class="col-sm-10">@Model.Mobile</dd>
<dt class="col-sm-2">Status</dt><dd class="col-sm-10">@Model.Status</dd>
<dt class="col-sm-2">Verified</dt><dd class="col-sm-10">@Model.IsVerified</dd></dl>
<form asp-action="Status" method="post"><input name="id" type="hidden" value="@Model.UserId"/><input type="hidden" name="active" value="@(Model.Status != "Active")" />
<button class="btn btn-outline-warning">@(Model.Status == "Active" ? "Deactivate" : "Reactivate")</button></form>
<h2 class="mt-4">Assigned roles</h2><table class="table"><thead><tr><th>Role</th><th>Department ID</th><th></th></tr></thead><tbody>
@foreach(var r in (IReadOnlyList<UA.Facade.DTO.Administration.RoleAssignmentDto>)ViewBag.Roles){<tr><td>@r.RoleName</td><td>@r.DepartmentId</td>
<td><form asp-action="RemoveRole" method="post"><input type="hidden" name="id" value="@Model.UserId" /><input type="hidden" name="roleId" value="@r.RoleId" /><button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr>}</tbody></table>
<h2>Assign role</h2><form asp-action="Assign" method="post"><input type="hidden" name="id" value="@Model.UserId" />
<label>Role</label><select name="roleId" class="form-select">@foreach(var r in (IReadOnlyList<UA.Facade.DTO.Administration.RoleDto>)ViewBag.RoleChoices){<option value="@r.RoleId">@r.Name</option>}</select>
<label>Department ID (for scoped roles)</label><input class="form-control" type="number" name="departmentId" />
<button class="btn btn-primary mt-2">Assign</button></form>
