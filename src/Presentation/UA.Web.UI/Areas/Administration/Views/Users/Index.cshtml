@model IReadOnlyList<UA.Facade.DTO.Administration.UserDto>
@{ViewData["Title"]="Users";}
<div class="d-flex justify-content-between align-items-center"><h1>User accounts</h1><a asp-action="Create" class="btn btn-primary">Create user</a></div>
<table class="table"><thead><tr><th>Username</th><th>Email</th><th>Status</th><th>Verified</th><th></th></tr></thead><tbody>
@foreach(var u in Model){<tr><td>@u.Username</td><td>@u.Email</td><td>@u.Status</td><td>@u.IsVerified</td><td><a asp-action="Details" asp-route-id="@u.UserId">Manage</a></td></tr>}
</tbody></table>
