@model IReadOnlyList<UA.Facade.DTO.Administration.NotificationTemplateDto>
@{ViewData["Title"]="Notification templates";}
<h1>Notification templates</h1><table class="table"><thead><tr><th>Code</th><th>Channel</th><th>Subject</th><th>Active</th><th></th></tr></thead><tbody>
@foreach(var t in Model){<tr><td>@t.Code</td><td>@t.Channel</td><td>@t.Subject</td><td>@t.Active</td>
<td><a asp-action="Edit" asp-route-id="@t.Id">Edit</a></td></tr>}</tbody></table>
