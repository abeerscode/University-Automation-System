@model IReadOnlyList<UA.Facade.DTO.Administration.AuditDto>
@{ViewData["Title"]="Audit trail";}
<h1>Audit trail</h1><form asp-action="Index" method="get"><label>Entity name</label><input type="text" name="entity" value="@ViewBag.Entity" class="form-control" /><button class="btn btn-outline-primary">Search</button></form>
<p><a asp-action="Export" asp-route-entity="@ViewBag.Entity" class="btn btn-outline-secondary">Export CSV (requires permission)</a></p>
<table class="table mt-3"><thead><tr><th>When (Dhaka)</th><th>User ID</th><th>Action</th><th>Entity / ID</th><th>Changes</th></tr></thead><tbody>
@foreach(var a in Model){<tr><td>@a.Timestamp</td><td>@a.UserId</td><td>@a.Action</td><td>@a.Entity / @a.Key</td>
<td><details><summary>View changes</summary><strong>Before</strong><pre>@a.Old</pre><strong>After</strong><pre>@a.New</pre></details></td></tr>}</tbody></table>
