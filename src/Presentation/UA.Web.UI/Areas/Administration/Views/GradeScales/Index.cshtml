@model IReadOnlyList<UA.Facade.DTO.Administration.GradeBandDto>
@{ViewData["Title"]="Grade scale";}
<h1>Grade scale (Department @ViewBag.DepartmentId)</h1>
<form method="get"><label>Department ID</label><input type="number" name="departmentId" value="@ViewBag.DepartmentId" class="form-control"/><button class="btn btn-outline-primary">Filter</button></form>
<p class="mt-3"><a asp-action="Edit" asp-route-departmentId="@ViewBag.DepartmentId" class="btn btn-primary">Create version</a></p>
<table class="table"><thead><tr><th>Version</th><th>Grade</th><th>Min</th><th>Max</th><th>Points</th></tr></thead><tbody>
@foreach(var b in Model){<tr><td>@b.VersionNo</td><td>@b.LetterGrade</td><td>@b.MinMark</td><td>@b.MaxMark</td><td>@b.GradePoint</td></tr>}</tbody></table>
