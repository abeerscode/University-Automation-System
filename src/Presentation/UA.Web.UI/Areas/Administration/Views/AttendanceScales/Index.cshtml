@model IReadOnlyList<UA.Facade.DTO.Administration.AttendanceBandDto>
@{ViewData["Title"]="Attendance bands";}
<h1>Attendance bands (Department @ViewBag.DepartmentId)</h1>
<form method="get"><label>Department ID</label><input type="number" name="departmentId" value="@ViewBag.DepartmentId" class="form-control"/><button class="btn btn-outline-primary">Filter</button></form>
<p class="mt-3"><a asp-action="Edit" asp-route-departmentId="@ViewBag.DepartmentId" class="btn btn-primary">Create version</a></p>
<table class="table"><thead><tr><th>Version</th><th>Minimum attendance %</th><th>Marks earned %</th></tr></thead><tbody>
@foreach(var b in Model){<tr><td>@b.VersionNo</td><td>@b.MinPercent</td><td>@b.MarkPercent</td></tr>}</tbody></table>
