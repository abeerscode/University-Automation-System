@model IReadOnlyList<UA.Facade.DTO.Administration.MarkPartDto>
@{ViewData["Title"]="Mark scheme";}
<h1>Mark scheme (Department @ViewBag.DepartmentId; @ViewBag.CourseType)</h1>
<form method="get"><label>Department ID</label><input type="number" name="departmentId" value="@ViewBag.DepartmentId" class="form-control"/>
<label>Course type</label><select name="courseType" class="form-select"><option>Theory</option><option>Lab</option></select><button class="btn btn-outline-primary">Filter</button></form>
<p class="mt-3"><a asp-action="Edit" asp-route-departmentId="@ViewBag.DepartmentId" asp-route-courseType="@ViewBag.CourseType" class="btn btn-primary">Create version</a></p>
<table class="table"><thead><tr><th>Version</th><th>Component</th><th>Max marks</th><th>Attendance</th></tr></thead><tbody>
@foreach(var b in Model){<tr><td>@b.VersionNo</td><td>@b.Name</td><td>@b.MaxMarks</td><td>@b.AttendanceBased</td></tr>}</tbody></table>
