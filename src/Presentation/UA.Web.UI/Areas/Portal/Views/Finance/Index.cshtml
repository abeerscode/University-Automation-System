@model UA.Facade.DTO.Finance.LedgerDto
@{ ViewData["Title"]="My finances"; }
<h1>My dues and payments</h1><h2 class="h4">Student @Model.StudentId</h2><p>Outstanding balance: <strong>BDT @Model.Balance.ToString("F2")</strong></p>
<div class="table-responsive"><table class="table"><thead><tr><th>Fee</th><th>Term ID</th><th>Amount</th><th>Paid</th><th>Balance</th><th>Deadline</th><th>Status</th></tr></thead><tbody>@foreach(var d in Model.Dues){<tr><td>@d.Fee</td><td>@d.TermId</td><td>@d.Amount.ToString("F2")</td><td>@d.Paid.ToString("F2")</td><td>@d.Balance.ToString("F2")</td><td>@d.Deadline.ToString("yyyy-MM-dd")</td><td>@d.Status</td></tr>}</tbody></table></div>
<p><a asp-action="Invoice" class="btn btn-outline-primary">View outstanding invoice</a></p><h2 class="h4">Payment history</h2><div class="table-responsive"><table class="table"><thead><tr><th>Paid at</th><th>Method</th><th>BDT</th><th>Receipt</th></tr></thead><tbody>@foreach(var p in Model.Payments){<tr><td>@p.PaidAt</td><td>@p.Method</td><td>@p.Amount.ToString("F2")</td><td>@if(!string.IsNullOrEmpty(p.ReceiptNo)){<a asp-controller="Finance" asp-action="Receipt" asp-route-id="@p.Id">@p.ReceiptNo (PDF)</a>}</td></tr>}</tbody></table></div>
