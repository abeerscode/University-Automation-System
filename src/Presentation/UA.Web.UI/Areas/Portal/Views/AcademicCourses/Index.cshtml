@model IReadOnlyList<UA.Facade.DTO.Academic.StudentCourseRow>
@{ViewData["Title"]="My courses and attendance";}
<h1>My courses and attendance</h1>
@foreach(var c in Model){<div class="card mb-3"><div class="card-body"><h2 class="h5">@c.Course</h2><p>@c.Term · Registration: @c.Status · Attendance: @(c.Attendance?.ToString("F2")??"Not recorded") @(c.Shortage?"% — shortage":"")</p><h3 class="h6">Weekly routine (Monday = 1)</h3>@foreach(var r in c.Routine){<p class="mb-1">Day @r.Day · @r.Room · @r.Start.ToString(@"hh\:mm") – @r.End.ToString(@"hh\:mm")</p>}</div></div>}
@if(Model.Count==0){<p>No registered courses.</p>}
