@model IReadOnlyList<MenteeSummaryDto>
@{ ViewData["Title"] = "My mentees"; }
<h1>My mentees</h1><p>Only students in your active batch or section mentor assignments are visible.</p>
<table class="table table-striped"><thead><tr><th>Student ID</th><th>Name</th><th>Roll</th><th>Section</th><th>Status</th></tr></thead><tbody>
@foreach(var s in Model){<tr><td>@s.StudentId</td><td>@s.FullName</td><td>@s.RollNo</td><td>@s.Section</td><td>@s.Status</td></tr>}</tbody></table>
@if(Model.Count==0){<p class="text-muted">No currently assigned students.</p>}
