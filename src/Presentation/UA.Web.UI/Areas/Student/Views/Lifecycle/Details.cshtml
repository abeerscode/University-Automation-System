@model LifecycleDetails
@inject UA.Framework.Time.IClock Clock
@{ViewData["Title"]="Student lifecycle";var s=Model.Student;}
@if(!Model.Own){<a asp-action="Index">Back to students</a>}
<h1>@s.Name</h1>@if(Model.CanEquivalence){<p><a asp-action="Schemes">Configure non-theory retake schemes</a></p>}<p>@s.StudentId · @s.Status · Limit @s.Limit.ToString("yyyy-MM-dd")</p>
<div class="card card-body mb-3"><h2 class="h5">Failed-course backlog</h2><table class="table"><thead><tr><th>Course</th><th>Grade</th><th>Latest attempt</th><th>Retake status</th></tr></thead><tbody>@foreach(var b in Model.Backlog){<tr><td>@b.Course</td><td>@b.Grade</td><td>@b.Attempt</td><td>@b.RetakeStatus</td></tr>}</tbody></table>@if(Model.Backlog.Length==0){<p>No published failed courses.</p>}
@if(Model.CanRetake&&s.Status=="Active"&&Model.RetakeOfferings.Length>0){<form asp-action="Retake" method="post"><input type="hidden" name="id" value="@s.StudentId"/><label>Junior batch offering</label><select name="offeringId" class="form-select" required>@foreach(var o in Model.RetakeOfferings){<option value="@o.Id">@o.Label</option>}</select><label>Late override reference (if required)</label><input name="reference" class="form-control" maxlength="30"/><label>Reason for late override</label><input name="reason" class="form-control" maxlength="255"/><button class="btn btn-primary mt-2">Enroll retake and create fee</button></form><p class="small text-muted mt-2">Theory or configured non-theory retakes. The Controller generates seats in the final exam event; attendance is not required.</p>}</div>
@if(Model.CanRetake&&s.Status=="Active"&&Model.Backlog.Length>0){<form asp-action="SpecialRetake" method="post" class="card card-body mb-3"><h2 class="h5">Special final-semester retake</h2><input type="hidden" name="id" value="@s.StudentId"/><label>Failed course (semester 8 only)</label><select name="courseId" class="form-select">@foreach(var b in Model.Backlog){<option value="@b.CourseId">@b.Course</option>}</select><label>Term with draft special event</label><select name="termId" class="form-select">@foreach(var t in Model.Terms){<option value="@t.Id">@t.Label</option>}</select><button class="btn btn-primary mt-2">Enroll special retake</button><p>Assign a designated marker on the new special offering in Academic Operations before marks entry.</p></form>}
<div class="card card-body mb-3"><h2 class="h5">Semester drop and rejoin</h2><p>Drop status: @s.DropStatus · Semester @(s.DropSemester?.ToString()??"—") · Target batch @(s.TargetBatch?.ToString()??"Not assigned")</p>
@if(Model.CanRequestDrop&&s.Status=="Active"&&(s.DropStatus is "None" or "Rejected")) {<form asp-action="RequestDrop" method="post"><input type="hidden" name="id" value="@s.StudentId"/><label>Term to drop (before registration)</label><select class="form-select" name="termId" required>@foreach(var t in Model.Terms){<option value="@t.Id">@t.Label</option>}</select><button class="btn btn-primary mt-2">Record drop request</button></form>}
@if(Model.CanRecommend&&s.DropStatus=="Requested"){<form asp-action="RecommendDrop" method="post"><input type="hidden" name="id" value="@s.StudentId"/><button class="btn btn-primary">Recommend drop</button></form>}
@if(Model.CanApprove&&s.DropStatus=="Recommended"){<form asp-action="DecideDrop" method="post"><input type="hidden" name="id" value="@s.StudentId"/><label>Requested term</label><select name="termId" class="form-select" required>@foreach(var t in Model.Terms){<option value="@t.Id">@t.Label</option>}</select><label>Registrar physical approval reference (SemesterDrop)</label><input name="reference" class="form-control" maxlength="30" required/><button class="btn btn-primary mt-2">Record approval / rejection</button></form>}
@if(Model.CanRejoin&&s.DropStatus=="Approved"){<form asp-action="Rejoin" method="post"><input type="hidden" name="id" value="@s.StudentId"/><label>Junior batch's matching term</label><select name="termId" class="form-select" required>@foreach(var t in Model.Terms){<option value="@t.Id">@t.Label</option>}</select><button class="btn btn-primary mt-2">Place in junior batch and register</button></form>}
@if((s.DropStatus is "Approved" or "Rejoined")&&Model.CanEquivalence&&Model.OldCourses.Length>0&&Model.NewCourses.Length>0){<h3 class="h6 mt-3">Course equivalence decision</h3><p class="small text-muted">Record approved equivalents before registering the affected courses so enrollment and tuition exclude recognized credits.</p><form asp-action="Equivalence" method="post"><input type="hidden" name="id" value="@s.StudentId"/><label>Passed previous course</label><select name="oldCourseId" class="form-select">@foreach(var c in Model.OldCourses){<option value="@c.Id">@c.Label</option>}</select><label>Junior curriculum course</label><select name="newCourseId" class="form-select">@foreach(var c in Model.NewCourses){<option value="@c.Id">@c.Label</option>}</select><label>Department Head approval reference (CourseEquivalence)</label><input name="reference" class="form-control" required maxlength="30"/><button class="btn btn-primary mt-2">Record equivalence</button></form>}
</div>
<div class="card card-body mb-3"><h2 class="h5">Graduation eligibility</h2><p>Credits: @Model.Graduation.Earned / @Model.Graduation.Required · CGPA: @Model.Graduation.Cgpa.ToString("F2")</p>@if(Model.Graduation.Eligible){<p class="text-success">All checks passed.</p>}else{<ul>@foreach(var r in Model.Graduation.Reasons){<li>@r</li>}</ul>}
@if(Model.CanGraduate&&Model.Graduation.Eligible){<form asp-action="Graduate" method="post"><input type="hidden" name="id" value="@s.StudentId"/><input type="hidden" name="alumni" value="false"/><button class="btn btn-success">Mark Graduated</button></form>}
@if(Model.CanGraduate&&s.Status=="Graduated"){<form asp-action="Graduate" method="post"><input type="hidden" name="id" value="@s.StudentId"/><input type="hidden" name="alumni" value="true"/><button class="btn btn-primary">Mark Alumni</button></form>}
@if(Model.CanGraduate&&Clock.Today>s.Limit&&(s.Status is "Active" or "Dropped" or "Suspended")){<form asp-action="DecideLimit" method="post"><input type="hidden" name="id" value="@s.StudentId"/><label>Registrar decision</label><select name="status" class="form-select"><option>Withdrawn</option><option>Expelled</option><option>Suspended</option></select><label>Approved StudentStatus reference</label><input name="reference" maxlength="30" required class="form-control"/><button class="btn btn-outline-danger mt-2">Record limit decision</button></form>}</div>
<div class="card card-body"><h2 class="h5">Document requests</h2>@if(Model.Own){<form asp-action="RequestDocument" method="post" class="d-flex gap-2 mb-3"><select name="type" class="form-select"><option>Transcript</option><option>Testimonial</option><option>Certificate</option><option>ID card</option></select><button class="btn btn-primary">Request document</button></form><p class="small text-muted">A configured document fee is required. Pay the due using the existing finance process.</p>}
<table class="table"><thead><tr><th>Request</th><th>Type</th><th>Status</th><th>Due</th><th></th></tr></thead><tbody>@foreach(var d in Model.Documents){<tr><td>@d.Id</td><td>@d.Type</td><td>@d.Status</td><td>@d.DueId</td><td>@if(Model.CanProcessDocuments&&d.Status=="Requested"){<form asp-action="ProcessDocument" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@s.StudentId"/><input type="hidden" name="requestId" value="@d.Id"/><button name="issue" value="true" class="btn btn-sm btn-primary">Issue</button><button name="issue" value="false" class="btn btn-sm btn-outline-danger">Reject</button></form>}</td></tr>}</tbody></table></div>
