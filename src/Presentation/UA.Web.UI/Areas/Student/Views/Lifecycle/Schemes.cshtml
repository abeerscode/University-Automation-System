@model RetakeSchemePage
@{ViewData["Title"]="Non-theory retake schemes";}
<h1>Non-theory retake schemes</h1><p>Department Head: configure exam-only components totaling 100 marks, effective from the selected term. Existing retake enrollments are protected.</p>
<form asp-action="SaveScheme" method="post" class="card card-body"><label>Department</label><select name="departmentId" class="form-select" required>@foreach(var d in Model.Departments){<option value="@d.Id">@d.Label</option>}</select><label>Effective term</label><select name="termId" class="form-select" required>@foreach(var t in Model.Terms){<option value="@t.Id">@t.Label</option>}</select><label>Course type</label><select name="type" class="form-select" required>@foreach(var t in Model.Types){<option>@t</option>}</select><div id="parts"><div class="row g-2 mt-2"><div class="col"><input name="parts[0].Name" class="form-control" placeholder="Component name" maxlength="40" required/></div><div class="col"><input name="parts[0].Marks" class="form-control" type="number" step="0.01" min="0.01" max="100" required/></div></div></div><button type="button" id="add-part" class="btn btn-outline-secondary mt-2">Add component</button><button class="btn btn-primary mt-2">Save new version</button></form>
@section Scripts {<script src="~/js/retake-schemes.js" asp-append-version="true"></script>}
