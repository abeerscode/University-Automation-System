@model StatusChangeForm
@{ ViewData["Title"] = "Change student status"; }
<h1>Change status — @Model.StudentId</h1><p>Only authorized administrative transitions are supported here. Drop, rejoin and graduation use later dedicated workflows.</p>
<form asp-action="Change" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" asp-for="StudentId" />
<div class="mb-3"><label asp-for="Status"></label><select asp-for="Status" class="form-select"><option>Suspended</option><option>Active</option><option>Withdrawn</option><option>Expelled</option></select></div>
<div class="mb-3"><label asp-for="EffectiveDate"></label><input asp-for="EffectiveDate" class="form-control" /></div>
<div class="mb-3"><label asp-for="Reason"></label><textarea asp-for="Reason" class="form-control"></textarea></div>
<div class="mb-3"><label asp-for="ApprovalReference">Approved StudentStatus reference</label><input asp-for="ApprovalReference" class="form-control" /></div>
<button class="btn btn-primary">Record status change</button></form>
