@model UA.Facade.DTO.Finance.LedgerDto
@{ViewData["Title"]="Student invoice";int? termId=ViewBag.TermId;var rows=Model.Dues.Where(x=>(termId==null||x.TermId==termId)&&x.Balance>0&&x.Status is not ("Reversed" or "Waived")).ToArray();}
<h1>Student outstanding invoice</h1><p>Student ID: @Model.StudentId</p><p class="alert alert-info">This is a statement of outstanding dues, not a payment receipt. Online payment is not enabled.</p><div class="table-responsive"><table class="table"><thead><tr><th>Due reference</th><th>Term</th><th>Fee</th><th>Deadline</th><th>Amount (BDT)</th><th>Paid</th><th>Outstanding</th></tr></thead><tbody>@foreach(var r in rows){<tr><td>DU-@r.Id</td><td>@r.TermId</td><td>@r.Fee</td><td>@r.Deadline.ToString("yyyy-MM-dd")</td><td>@r.Amount.ToString("F2")</td><td>@r.Paid.ToString("F2")</td><td>@r.Balance.ToString("F2")</td></tr>}</tbody></table></div><h2 class="h5">Total payable: BDT @rows.Sum(r=>r.Balance).ToString("F2")</h2><button type="button" data-print-document class="btn btn-outline-secondary no-print">Print / Save PDF</button>
