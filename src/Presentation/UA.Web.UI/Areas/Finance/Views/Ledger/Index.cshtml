@model LedgerDto
@{ ViewData["Title"]="Student ledger"; }
<h1>Student ledger</h1><form method="get" class="d-flex gap-2 mb-3"><input name="studentId" value="@Model?.StudentId" class="form-control" maxlength="8" placeholder="Student ID" required /><button class="btn btn-primary">Find</button></form>
@if(Model is not null){<h2 class="h4">Student @Model.StudentId</h2><p>Outstanding balance: <strong>BDT @Model.Balance.ToString("F2")</strong></p>
<div class="table-responsive"><table class="table"><thead><tr><th>Fee</th><th>Term ID</th><th>Amount</th><th>Paid</th><th>Balance</th><th>Deadline</th><th>Status</th></tr></thead><tbody>@foreach(var d in Model.Dues){<tr><td>@d.Fee</td><td>@d.TermId</td><td>@d.Amount.ToString("F2")</td><td>@d.Paid.ToString("F2")</td><td>@d.Balance.ToString("F2")</td><td>@d.Deadline.ToString("yyyy-MM-dd")</td><td>@d.Status</td></tr>}</tbody></table></div>
<details class="card card-body mb-3"><summary>Apply approved fee waiver (authorized finance staff only)</summary><form asp-action="Waiver" method="post" class="row g-2 mt-2"><input type="hidden" name="studentId" value="@Model.StudentId"/><div class="col-md-4"><label>Term ID</label><input name="termId" type="number" min="1" required class="form-control"/></div><div class="col-md-4"><label>Discount BDT</label><input name="discount" type="number" min="0.01" step="0.01" required class="form-control"/></div><div class="col-md-4"><label>Approved FeeWaiver approval ID</label><input name="approvalId" type="number" min="1" required class="form-control"/></div><div><button class="btn btn-outline-primary">Apply discount</button></div></form></details>
<p><a asp-action="Invoice" asp-route-studentId="@Model.StudentId" class="btn btn-outline-primary">View outstanding invoice</a></p><h2 class="h4">Payment history</h2><div class="table-responsive"><table class="table"><thead><tr><th>Paid at</th><th>Method</th><th>BDT</th><th>Receipt</th></tr></thead><tbody>@foreach(var p in Model.Payments){<tr><td>@p.PaidAt</td><td>@p.Method</td><td>@p.Amount.ToString("F2")</td><td>@if(!string.IsNullOrEmpty(p.ReceiptNo)){<a asp-controller="Payments" asp-action="Receipt" asp-route-id="@p.Id">@p.ReceiptNo (PDF)</a>}</td></tr>}</tbody></table></div> }
