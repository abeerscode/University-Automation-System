@model IReadOnlyList<FeeRateDto>
@{ ViewData["Title"]="Fee rates"; var lookups=(FinanceLookup)ViewBag.Lookups; }
<h1>Fee rates</h1>
<p>Rates are versioned by department and effective date. Existing dues retain their original amount.</p>
<form asp-action="Create" method="post" class="row g-2 mb-4">
<div class="col-md-3"><label class="form-label">Department</label><select name="departmentId" class="form-select" required>@foreach(var d in lookups.Departments){<option value="@d.Key">@d.Value</option>}</select></div>
<div class="col-md-3"><label class="form-label">Fee type</label><select name="name" class="form-select" required>@foreach(var n in FeeNames.Units){<option value="@n.Key">@n.Key (@n.Value)</option>}</select></div>
<div class="col-md-2"><label class="form-label">Amount (BDT)</label><input name="amount" type="number" step="0.01" min="0" max="99999999.99" class="form-control" required /></div>
<div class="col-md-2"><label class="form-label">Effective date</label><input name="effectiveFrom" type="date" class="form-control" required /></div><div class="col-md-2 align-self-end"><button class="btn btn-primary">Add rate</button></div></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Department</th><th>Fee</th><th>Unit</th><th>BDT</th><th>Effective from</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@(lookups.Departments.FirstOrDefault(d=>d.Key==r.DepartmentId).Value)</td><td>@r.Name</td><td>@r.Unit</td><td>@r.Amount.ToString("F2")</td><td>@r.EffectiveFrom.ToString("yyyy-MM-dd")</td></tr>}</tbody></table></div>
<h2 class="h4">Generate semester dues</h2><p>Uses the student's current batch curriculum and attended term. Repeated generation retains existing dues.</p>
<form asp-controller="Dues" asp-action="Generate" method="post" class="row g-2"><div class="col-md-4"><label>Student ID</label><input name="studentId" maxlength="8" required class="form-control" /></div><div class="col-md-4"><label>Term</label><select name="termId" class="form-select" required>@foreach(var t in lookups.Terms){<option value="@t.Key">@t.Value</option>}</select></div><div class="col-md-4 align-self-end"><button class="btn btn-primary">Generate</button></div></form>
