@model IReadOnlyList<UA.Facade.DTO.Website.PageVersionRow>
@{ViewData["Title"]="Website content";var departments=(IReadOnlyList<UA.Facade.DTO.Admission.AdmissionSeat>)ViewBag.Departments;}
<h1>Website content management</h1><p>New content is published only after independent approval. An approved version remains visible until a newer version is approved. Plain text is supported. For formatted content, start with html: on its own line and use well-formed HTML (paragraphs, headings, lists, tables, links and local images). Unsupported markup is discarded.</p>
<form asp-action="Draft" method="post" class="card card-body mb-4"><h2 class="h5">New page or content revision</h2><label>Slug (e.g. about, contact)</label><input name="slug" maxlength="100" required class="form-control mb-2"/><label>Page title (keep existing title for revisions)</label><input name="title" maxlength="200" required class="form-control mb-2"/><label>Department</label><select name="departmentId" class="form-select mb-2"><option value="">Central university page</option>@foreach(var d in departments){<option value="@d.DepartmentId">@d.Department</option>}</select><label>Content (plain text or restricted HTML)</label><textarea name="content" required maxlength="30000" rows="7" class="form-control mb-2"></textarea><button class="btn btn-primary">Save draft</button></form>
<details class="card card-body mb-3"><summary>University profile (central editors)</summary><form asp-action="Profile" method="post" class="row g-2 mt-2">
@{var approved=Model.Where(x=>x.Slug=="site-profile"&&x.Approver.HasValue).OrderByDescending(x=>x.Version).FirstOrDefault();var profile=UA.Facade.Rules.Website.SiteProfile.Parse(approved?.Content);}
@foreach(var f in new[]{("name","University name",profile.Name),("logo","Logo path",profile.Logo),("address","Address",profile.Address),("email","Email",profile.Email),("telephone","Telephone",profile.Telephone),("facebook","Facebook HTTPS URL",profile.Facebook),("linkedIn","LinkedIn HTTPS URL",profile.LinkedIn)}){<div class="col-md-6"><label>@f.Item2</label><input name="@f.Item1" value="@f.Item3" class="form-control"/></div>}<div><button class="btn btn-primary">Save profile draft</button></div></form></details>
<form asp-action="UploadImage" method="post" enctype="multipart/form-data" class="card card-body mb-3"><label>Upload public image (central editors; never upload private documents)</label><input name="image" type="file" accept="image/png,image/jpeg" required class="form-control"/><button class="btn btn-outline-primary mt-2">Upload and get path</button></form>
<h2 class="h4">Version history</h2>@foreach(var v in Model){<article class="card mb-2"><div class="card-body"><h3 class="h5">@v.Title (@v.Slug) · version @v.Version</h3><p>Author @v.Author · @v.Changed · @(v.Approver.HasValue?"Approved by "+v.Approver:"Pending approval")</p><details><summary>Review content</summary><div class="table-responsive">@Html.Raw(UA.Facade.Rules.Website.PublicContent.Render(v.Content))</div></details>@if(!v.Approver.HasValue){<form asp-action="Approve" method="post"><input name="id" type="hidden" value="@v.VersionId"/><button class="btn btn-sm btn-outline-primary">Approve version</button></form>}</div></article>}
