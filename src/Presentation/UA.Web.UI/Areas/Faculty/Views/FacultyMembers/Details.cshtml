@model FacultyDetailDto
@{ ViewData["Title"] = "Faculty profile"; }
<div class="d-flex justify-content-between mb-3"><h1>@Model.FullName</h1><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit profile</a></div>
<div class="row g-3"><div class="col-md-3">@if(Model.HasPhoto){<img class="img-fluid rounded" alt="Faculty portrait" asp-append-version="false" src="@Url.Action("Photo", "FacultyMembers", new { area = "Faculty", id = Model.Id })" />}</div>
<div class="col-md-9"><dl class="row"><dt class="col-sm-4">Employee reference / username</dt><dd class="col-sm-8">@Model.EmployeeRef</dd>
<dt class="col-sm-4">Department</dt><dd class="col-sm-8">@Model.Department</dd>
<dt class="col-sm-4">Designation</dt><dd class="col-sm-8">@Model.Designation</dd>
<dt class="col-sm-4">Faculty type</dt><dd class="col-sm-8">@Model.Type</dd>
<dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd>
<dt class="col-sm-4">Qualifications</dt><dd class="col-sm-8">@Model.Qualifications</dd>
<dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@Model.Phone</dd>
<dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd></dl></div></div>
<a asp-action="Index">Back to faculty list</a>
